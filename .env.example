# ==============================================================================
# EHR Blockchain System — root environment
#
# docker-compose.yaml reads this file. Do not copy it by hand: run
#     node scripts/init-env.js
# (setup.sh and start.sh run it for you). It creates .env, generates every
# secret marked GENERATED below, and writes matching per-service .env files for
# running services outside Docker. Existing values are never overwritten.
# ==============================================================================

NODE_ENV=development

# ── Shared secrets (GENERATED) ────────────────────────────────────────────────
# One JWT signing key shared by the hospital APIs, patient-api, DigiLocker
# service and dashboard-api so a token issued by one is accepted by the others.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Internal key every backend sends to ipfs-service as X-IPFS-Key.
IPFS_SERVICE_KEY=
# Key services use to post zero-PHI telemetry to dashboard-api /internal/events.
DASHBOARD_SERVICE_KEY=
# 32-byte key that encrypts DigiLocker vault documents and OAuth tokens.
# Back this up: without it anchored documents cannot be decrypted.
DIGILOCKER_VAULT_KEY=

# ── Hyperledger Fabric ────────────────────────────────────────────────────────
FABRIC_CHANNEL=ehrchannel
FABRIC_CHAINCODE=ehr
FABRIC_DOCKER_NETWORK=ehr_network

# ── DigiLocker ────────────────────────────────────────────────────────────────
# sandbox = built-in simulator with generated sample documents (default)
# live    = real DigiLocker; requires the partner credentials below
DIGILOCKER_MODE=sandbox
# YOU MUST SUPPLY THESE for live mode (issued by DigiLocker / API Setu to a
# registered partner). Leave blank in sandbox mode.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
# Public URL of the DigiLocker service as the browser reaches it, and where the
# browser returns after linking. Change both if you serve on another host.
DIGILOCKER_PUBLIC_URL=http://localhost:4007
DIGILOCKER_PORTAL_RETURN_URL=http://localhost:5174/digilocker
DIGILOCKER_CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost

# ── Optional AI provider ──────────────────────────────────────────────────────
# YOU MAY SUPPLY THIS. Without it the lab report agent uses its rule-based
# extraction instead of Gemini.
GEMINI_API_KEY=

# ── Browser-facing API URLs for the patient portal ────────────────────────────
VITE_PATIENT_API_URL=http://localhost:4005
VITE_DIGILOCKER_API_URL=http://localhost:4007
