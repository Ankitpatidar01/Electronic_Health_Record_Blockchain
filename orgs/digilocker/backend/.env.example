# ── Server ────────────────────────────────────────────────────
PORT=4007
NODE_ENV=development
LOG_LEVEL=info

# ── Auth ──────────────────────────────────────────────────────
# MUST be the same value as patient-api's JWT_SECRET: this service accepts the
# patient portal's bearer token.
JWT_SECRET=change-me-in-production-min-32-chars

# Browser origins allowed to call this service (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost

# ── Vault encryption ──────────────────────────────────────────
# 32 random bytes, hex (64 chars) or base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key makes every anchored document undecryptable.
DIGILOCKER_VAULT_KEY=

# ── DigiLocker provider ───────────────────────────────────────
# sandbox  → built-in simulator, no external calls, sample documents only
# live     → real DigiLocker (API Setu / MeriPehchaan) — needs partner credentials
DIGILOCKER_MODE=sandbox
# Public base URL of THIS service as the browser sees it (used for the OAuth
# redirect). Through nginx this is http://localhost/api/digilocker
DIGILOCKER_PUBLIC_URL=http://localhost:4007
# Where the browser is sent after linking completes.
DIGILOCKER_PORTAL_RETURN_URL=http://localhost:5174/digilocker

# Live mode only — issued to registered DigiLocker partners.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_AUTHORIZE_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/token
DIGILOCKER_ISSUED_FILES_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/2/files/issued
DIGILOCKER_FILE_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/file
DIGILOCKER_REVOKE_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/revoke

# Largest document accepted, in bytes (ipfs-service accepts 5 MB JSON bodies).
DIGILOCKER_MAX_DOCUMENT_BYTES=3145728

# ── Local state (link records, document metadata) ─────────────
DIGILOCKER_DATA_DIR=./data

# ── Fabric ────────────────────────────────────────────────────
FABRIC_BASE_PATH=../../hospital/EHR_hospitalOrg-main/ehr-network
PEER_ADDRESS=localhost:7051
FABRIC_CHANNEL=ehrchannel
FABRIC_CHAINCODE=ehr

# ── IPFS service ──────────────────────────────────────────────
IPFS_SERVICE_URL=http://localhost:4006
IPFS_SERVICE_KEY=change-me-in-production

# ── Dashboard telemetry (optional, zero-PHI) ──────────────────
DASHBOARD_EVENT_API_URL=
DASHBOARD_SERVICE_KEY=
