PORT=4001
NODE_ENV=development

JWT_SECRET=replace_with_32_plus_random_chars
JWT_EXPIRES_IN=8h

FABRIC_CHANNEL=ehrchannel
FABRIC_CHAINCODE=ehr

# Absolute path to ehr-network root (dir containing organizations/)
FABRIC_BASE_PATH=

# HMAC key (KNET) that normalizes patient ids into zero-PHI hashes for FHIR anchors.
# MUST be identical on every machine/peer that writes anchors (Mac and Linux),
# otherwise the same patient yields different hashes and anchors become unqueryable.
KNET=dev-knet-insecure-do-not-use-in-production

PEER_ADDRESS=localhost:7051

LOG_LEVEL=info

# ── IPFS service ─────────────────────────────────
IPFS_SERVICE_URL=http://localhost:4006
IPFS_SERVICE_KEY=change-me-in-production
