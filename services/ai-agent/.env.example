# Python Medical RAG System Environment Configuration Template
# Copy this file to .env for local overrides

# Data Directory Paths
MEDICAL_DATA_DIR=medical_data
PATIENT_DATA_DIR=patient_data
CHROMA_PERSIST_DIR=./chroma_db

# Local Embedding & LLM Models
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
LOCAL_LLM_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# LLM Generation Parameters
MAX_NEW_TOKENS=200
TEMPERATURE=0.2
TOP_P=0.9
TOP_K=40
REPETITION_PENALTY=1.2

# Application Settings
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
PYTHONIOENCODING=utf-8
