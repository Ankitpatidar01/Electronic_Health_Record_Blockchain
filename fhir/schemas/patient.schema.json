{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "patient.schema.json",
  "title": "FHIR R4 Patient (profile)",
  "type": "object",
  "required": ["resourceType", "id", "name"],
  "properties": {
    "resourceType": { "const": "Patient" },
    "id": { "type": "string" },
    "identifier": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["system", "value"],
        "properties": {
          "system": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "name": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["given"],
        "properties": {
          "given": { "type": "array", "items": { "type": "string" } },
          "family": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "gender": { "enum": ["male", "female", "other", "unknown"] },
    "birthDate": { "type": "string" },
    "telecom": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "address": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "city": { "type": "string" },
          "country": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
